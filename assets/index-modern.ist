% makeindex style for the coloured "modern" style: bold sans letter-group headings
% (A, B, C, ...) in the book's accent colour, and indented sub-entries.  Copied verbatim
% into a project as <book_id>.ist by `tb.py new-book` when that book's book.json entry sets
% "index": true; edit the project's own copy freely, it is never overwritten once it exists.
% Invoked automatically by `tb.py build`/`tb.py release` when <book_id>.idx
% is non-empty: makeindex -s <book_id>.ist build/<book_id>.idx -o build/<book_id>.ind
preamble "\\begin{theindex}\n"
postamble "\n\n\\end{theindex}\n"

headings_flag 1
heading_prefix "{\\sffamily\\bfseries\\Large\\color{accent} "
heading_suffix "}\\nopagebreak\n\\vspace{4pt}\\nopagebreak\n"

item_0 "\n  \\item "
item_1 "\n    \\subitem "
item_2 "\n      \\subsubitem "
item_01 "\n    \\subitem "
item_x1 "\n    \\subitem "
item_x2 "\n      \\subsubitem "

delim_0 ", "
delim_1 ", "
delim_2 ", "
delim_n ", "
delim_r "--"

line_max 100
